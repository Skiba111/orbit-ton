# ORBIT — environment variables template
# Copy to .env and fill in real values. NEVER commit .env.

# Wallet mnemonic (pays deployment gas)
MNEMONICS="word1 word2 ... word24"

# Fee-collector Ed25519 public key (hex, 64 chars)
FEE_COLLECTOR_PUBKEY="abcd1234..."

# TonCenter API key (optional — increases rate limits)
TONCENTER_API_KEY=""

# Relayer settings
FACTORY_ADDRESS="EQD..."
RELAYER_MNEMONIC="word1 word2 ... word24"
POLL_INTERVAL_MS=60000
NETWORK=testnet                    # testnet | mainnet
WEBHOOK_URL=                       # optional: https://api.orbit-ton.com/orbit/webhook
WEBHOOK_SECRET=                    # shared secret — must match webhook-server WEBHOOK_SECRET

# Webhook server (scripts/webhook-server.ts)
WEBHOOK_PORT=3001
# WEBHOOK_SECRET set above (same value for relayer and webhook-server)
LOG_FILE=data/charges.log

# Optional: seed known subscription addresses on first relayer run
# INITIAL_SUBSCRIPTIONS="EQDabc...,EQDdef..."
