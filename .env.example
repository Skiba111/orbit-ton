# ORBIT — environment variables template
# Copy to .env and fill in real values. NEVER commit .env.

# ── Deployment wallet ────────────────────────────────────────────────────────
WALLET_MNEMONIC="word1 word2 ... word24"   # 24-word seed phrase
WALLET_VERSION=v5                          # v5 = Tonkeeper/TG Wallet; v4 = older Tonkeeper
NETWORK=testnet                            # testnet | mainnet

# ── Key material ─────────────────────────────────────────────────────────────
# Fee-collector cold key — keep offline (hardware/paper)
FEE_COLLECTOR_PUBKEY="abcd1234..."         # hex Ed25519 pubkey, 64 chars

# Relayer hot key — lives on the server
RELAYER_PUBKEY="52dfadb8..."              # hex Ed25519 pubkey, 64 chars
RELAYER_MNEMONIC="word1 word2 ... word24"  # mnemonic of relayer key (server .env only)

# ── Registry / deploy ────────────────────────────────────────────────────────
REGISTRY_ADDRESS=""                        # ORBIT Registry address (share with service operators)
PLATFORM_FEE_BPS=0                        # extra platform fee (0–1000); protocol fee 1.5% always applies

# ── TonCenter ────────────────────────────────────────────────────────────────
TONCENTER_API_KEY=""                       # optional — increases rate limits (toncenter.com)

# ── Relayer (server) ─────────────────────────────────────────────────────────
FACTORY_ADDRESS="EQD..."                   # your Factory contract address
POLL_INTERVAL_MS=60000                     # polling interval in ms (default 60 s)
DB_PATH=data/subscriptions.json           # local subscription index
WAL_PATH=data/relayer-wal.json            # crash-safe charge intent journal

# ── Webhook ──────────────────────────────────────────────────────────────────
WEBHOOK_URL=                               # https://api.yourapp.com/orbit/webhook
WEBHOOK_SECRET=                            # shared secret — sent as X-Orbit-Secret header

# Webhook server (scripts/webhook-server.ts)
WEBHOOK_PORT=3001
LOG_FILE=data/charges.log

# ── Advanced ─────────────────────────────────────────────────────────────────
# Seed known subscription addresses on first relayer run (comma-separated)
# INITIAL_SUBSCRIPTIONS="EQDabc...,EQDdef..."
