# ═══════════════════════════════════════════════════════════════════════════════
# ORBIT — environment variables
# Copy to .env and fill in. NEVER commit .env to version control.
#
# ┌──────────────────────────────────────────────────────────────┐
# │  WHO FILLS WHAT                                              │
# │                                                              │
# │  Section A — ORBIT Protocol Owner (you, platform operator)  │
# │              Lives on the ORBIT backend server only.         │
# │              NEVER share RELAYER_MNEMONIC or KEEPER_MNEMONIC.│
# │              You PUBLISH only: RELAYER_PUBKEY and           │
# │              PROTOCOL_FEE_COLLECTOR in your docs.           │
# │                                                              │
# │  Section B — Service Operator (third-party integrator)      │
# │              Filled when deploying their own Factory.        │
# │              RELAYER_PUBKEY and PROTOCOL_FEE_COLLECTOR       │
# │              are COPIED from ORBIT docs — not self-generated.│
# │                                                              │
# │  Section C — Relayer script (advanced / self-hosted relay)  │
# └──────────────────────────────────────────────────────────────┘
# ═══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION A — ORBIT PROTOCOL OWNER
#  These keys belong on YOUR server. Never share with service operators.
# ══════════════════════════════════════════════════════════════════════════════

# Hot wallet that signs OP_CHARGE_EXT for ALL services on the platform.
# Generate keypair: npx ts-node scripts/_get-pubkey.ts
# → Publish ONLY the pubkey in your documentation (DEPLOYMENT.md).
# → Keep the mnemonic only on the backend server .env.
RELAYER_MNEMONIC="word1 word2 ... word24"
RELAYER_PUBKEY="52dfadb8..."               # hex Ed25519 pubkey (64 chars) — publish in docs

# Gas payer: triggers charge on every Subscription contract (sends 0.03 TON).
KEEPER_MNEMONIC="word1 word2 ... word24"

# Your protocol fee wallet (cold storage / hardware wallet recommended).
# Receives 1.5% of every charge across ALL services using ORBIT.
# Publish this address in DEPLOYMENT.md so operators can embed it when deploying.
PROTOCOL_FEE_COLLECTOR="EQ..."            # your cold wallet or multisig address

# TonCenter API key — increases rate limits (https://toncenter.com)
TONCENTER_API_KEY=""
TONCENTER_ENDPOINT="https://toncenter.com/api/v2/jsonRPC"
# Testnet:  https://testnet.toncenter.com/api/v2/jsonRPC

NETWORK=mainnet                            # testnet | mainnet


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION B — SERVICE OPERATOR (third-party integrator)
#  This section is for developers deploying their own Factory contract.
#  Share as a separate template: docs/OPERATOR_ENV.example
# ══════════════════════════════════════════════════════════════════════════════

# The wallet that deploys the Factory and becomes its on-chain owner.
# This MUST be the same wallet the operator connects in the ORBIT Dashboard.
# After deploy: get_owner() on the Factory will return this wallet's address.
WALLET_MNEMONIC="word1 word2 ... word24"   # operator's 24-word seed phrase
WALLET_VERSION=v5                          # v5 = Tonkeeper / TG Wallet; v4 = older Tonkeeper

# The operator's Ed25519 pubkey — controls withdrawals from their FeeCollector contract.
# This is the operator's OWN key, NOT the ORBIT relayer key.
# Generate: npx ts-node scripts/_get-pubkey.ts
FEE_COLLECTOR_PUBKEY="abcd1234..."        # operator's hex pubkey (64 chars)

# ── The following two values are PROVIDED BY ORBIT (copy from documentation) ──
#
# DO NOT generate these yourself. Copy them from:
#   https://github.com/Skiba111/orbit-ton/blob/main/docs/DEPLOYMENT.md
#
# RELAYER_PUBKEY        — the ORBIT relayer's public key (signs charges on your behalf)
# PROTOCOL_FEE_COLLECTOR — the ORBIT protocol fee wallet (receives 1.5% per charge)
#
# These are entered interactively during deploy-standalone.ts — not stored in .env.
NETWORK=testnet                            # testnet | mainnet (for deploy script)


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION C — RELAYER SCRIPT (scripts/relayer.ts)
#  For operators running their own charge relay (advanced / self-hosted mode).
# ══════════════════════════════════════════════════════════════════════════════

FACTORY_ADDRESS="EQ..."                   # your deployed Factory address (from deploy output)
POLL_INTERVAL_MS=60000                    # blockchain polling interval in ms
DB_PATH=data/subscriptions.json
WAL_PATH=data/relayer-wal.json            # crash-safe WAL journal

WEBHOOK_URL=                              # https://yourapp.com/orbit/webhook
WEBHOOK_SECRET=                           # shared secret; deliveries signed as X-Orbit-Signature: sha256=<hmac>

WEBHOOK_PORT=3001
LOG_FILE=data/charges.log

# Seed known subscription addresses on first run (comma-separated)
# INITIAL_SUBSCRIPTIONS="EQDabc...,EQDdef..."
