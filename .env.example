# ORBIT — environment variables template
# Copy to .env and fill in real values. NEVER commit .env.

# Wallet mnemonic (pays deployment gas)
MNEMONICS="word1 word2 ... word24"

# Fee-collector Ed25519 public key (hex, 64 chars)
FEE_COLLECTOR_PUBKEY="abcd1234..."

# TonCenter API key (optional — increases rate limits)
TONCENTER_API_KEY=""

# Relayer settings
FACTORY_ADDRESS="EQD..."
RELAYER_MNEMONIC="word1 word2 ... word24"
POLL_INTERVAL_MS=60000
NETWORK=testnet          # testnet | mainnet
WEBHOOK_URL=             # optional: https://yourapp.com/orbit/webhook
