    "@ton/sandbox": "^0.20.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.spec.ts"
    ],
    "moduleNameMapper": {
      "^@ton/ton$": "@ton/core"
    }
  },
  "dependencies": {
    "@ton/tolk-js": "^0.13.0",
    "@ton/ton": "^16.2.4"
